' Item 14 - Diagrama de sequência do UC010 Avaliar Curso. Mensagens e métodos do item 13.
' Gerar: python3 scripts/drawio-seqgen/seqgen.py <este arquivo> especificacao/diagramas/14-sequencia-uc010.drawio
@startuml 14-sequencia-uc010
actor Aluno
boundary AvaliarCursoModal
control ReviewController
control ReviewRequest
control ReviewService
entity Review
control ReviewRepository
database BD
Aluno -> AvaliarCursoModal ++ : aciona "Avaliar curso" na página do curso
AvaliarCursoModal -> ReviewController ++ : me( courseId )
ReviewController -> ReviewService ++ : getStudentReview( userId, courseId )
ReviewService -> ReviewRepository ++ : findByUserAndCourse( userId, courseId )
ReviewRepository -> BD ++ : SELECT reviews WHERE userId AND courseId
BD --> ReviewRepository : review
ReviewRepository --> ReviewService : review (ou null)
ReviewService --> ReviewController : review (ou null)
ReviewController --> AvaliarCursoModal : 200 OK (ou 404)
alt A1 - Aluno já avaliou o curso antes
AvaliarCursoModal --> Aluno : abre modal pré-preenchido com avaliação anterior para edição
else primeira avaliação
AvaliarCursoModal --> Aluno : abre modal vazio
end
Aluno -> AvaliarCursoModal ++ : preenche nota de 1 a 5 e comentário
alt A2 - Aluno cancela antes de confirmar
Aluno -> AvaliarCursoModal ++ : aciona "Cancelar"
AvaliarCursoModal --> Aluno : descarta alterações e mantém avaliação anterior
else confirma o envio
Aluno -> AvaliarCursoModal ++ : aciona "Confirmar"
AvaliarCursoModal -> ReviewController ++ : store( courseId, req )
ReviewController -> ReviewRequest ++ : rules()
ReviewRequest --> ReviewController : validação
alt E2 - envio sem nota selecionada
ReviewController --> AvaliarCursoModal : 422 VALIDATION_FAILED (fields.rating)
AvaliarCursoModal --> Aluno : bloqueia envio e indica que nota é obrigatória
else dados válidos
ReviewController -> ReviewService ++ : submitReview( userId, courseId, dto )
ReviewService -> ReviewService : validateEligibility( userId, courseId )
alt E1 - Aluno sem aula concluída no curso (R-1)
ReviewService --> ReviewController : 403 FORBIDDEN (sem aula concluída)
ReviewController --> AvaliarCursoModal : 403 FORBIDDEN
AvaliarCursoModal --> Aluno : bloqueia e informa necessidade de concluir ao menos uma aula
else Aluno elegível
ReviewService -> Review ++ : update( rating, comment )
Review --> ReviewService : review
ReviewService -> ReviewRepository ++ : save( review )
ReviewRepository -> BD ++ : INSERT INTO reviews ON DUPLICATE KEY UPDATE
BD --> ReviewRepository
ReviewRepository --> ReviewService
ReviewService -> ReviewService : averageRatingByCourse(courseId )
ReviewService -> BD ++ : SELECT AVG(rating) FROM reviews WHERE courseId
BD --> ReviewService
ReviewService --> ReviewController : review salva
ReviewController --> AvaliarCursoModal : 200 OK (ReviewResource)
AvaliarCursoModal --> Aluno : confirma avaliação salva e atualiza nota média do curso
end
end
end
@enduml
