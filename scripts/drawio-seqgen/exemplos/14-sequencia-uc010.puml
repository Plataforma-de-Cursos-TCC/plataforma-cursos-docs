' Item 14 - Diagrama de sequência do UC010 Avaliar Curso. Mensagens e métodos do item 13.
' Gerar: python3 scripts/drawio-seqgen/seqgen.py <este arquivo> especificacao/diagramas/14-sequencia-uc010.drawio
@startuml 14-sequencia-uc010
actor Aluno
boundary ReviewCourseModal
control ReviewController
control ReviewRequest
control ReviewService
entity Review
control ReviewRepository
database BD
Aluno -> ReviewCourseModal ++ : aciona "Avaliar curso" na página do curso
ReviewCourseModal -> ReviewController ++ : me(courseId)
ReviewController -> ReviewService ++ : getStudentReview(userId, courseId)
ReviewService -> ReviewRepository ++ : findByUserAndCourse(userId, courseId)
ReviewRepository -> BD ++ : SELECT reviews WHERE user_id AND course_id
BD --> ReviewRepository -- : review
ReviewRepository --> ReviewService -- : review (ou null)
ReviewService --> ReviewController -- : review (ou null)
ReviewController --> ReviewCourseModal -- : 200 OK (ou 404)
alt A1 - Aluno já avaliou o curso antes
ReviewCourseModal --> Aluno : abre modal pré-preenchido com avaliação anterior para edição
else primeira avaliação
ReviewCourseModal --> Aluno -- : abre modal vazio
end
Aluno -> ReviewCourseModal ++ : preenche nota de 1 a 5 e comentário
deactivate ReviewCourseModal
alt A2 - Aluno cancela antes de confirmar
Aluno -> ReviewCourseModal ++ : aciona "Cancelar"
ReviewCourseModal --> Aluno -- : descarta alterações e mantém avaliação anterior
else confirma o envio
Aluno -> ReviewCourseModal ++ : aciona "Confirmar"
ReviewCourseModal -> ReviewController ++ : store(courseId, req)
ReviewController -> ReviewRequest ++ : rules()
ReviewRequest --> ReviewController -- : validação
alt E2 - envio sem nota selecionada
ReviewController --> ReviewCourseModal : 422 VALIDATION_FAILED (fields.rating)
ReviewCourseModal --> Aluno : bloqueia envio e indica que nota é obrigatória
else dados válidos
ReviewController -> ReviewService ++ : submitReview(userId, courseId, dto)
ReviewService -> ReviewService : validateEligibility(userId, courseId)
alt E1 - Usuário sem matrícula ativa no curso
ReviewService --> ReviewController : 403 FORBIDDEN (apenas matriculados)
ReviewController --> ReviewCourseModal : 403 FORBIDDEN
ReviewCourseModal --> Aluno : bloqueia e informa que apenas matriculados podem avaliar
else E1 - Aluno sem aula concluída no curso (R-1)
ReviewService --> ReviewController : 403 FORBIDDEN (sem aula concluída)
ReviewController --> ReviewCourseModal : 403 FORBIDDEN
ReviewCourseModal --> Aluno : bloqueia e informa necessidade de concluir ao menos uma aula
else Aluno elegível
ReviewService -> Review ++ : update(rating, comment)
Review --> ReviewService -- : review
ReviewService -> ReviewRepository ++ : save(review)
ReviewRepository -> BD ++ : INSERT INTO reviews ON CONFLICT (user_id, course_id) DO UPDATE
BD --> ReviewRepository --
ReviewRepository --> ReviewService --
ReviewService -> ReviewRepository ++ : averageRatingByCourse(courseId)
ReviewRepository -> BD ++ : SELECT AVG(rating) FROM reviews WHERE course_id
BD --> ReviewRepository -- : média
ReviewRepository --> ReviewService -- : averageRating
ReviewService --> ReviewController -- : review salva
ReviewController --> ReviewCourseModal -- : 200 OK (ReviewResource)
ReviewCourseModal --> Aluno -- : confirma avaliação salva e atualiza nota média do curso
end
end
end
@enduml
