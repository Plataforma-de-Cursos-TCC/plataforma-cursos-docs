' Item 14 - Diagrama de sequência do UC001 Conversar com Tutor de IA (Área D). Camadas e métodos do item 13.
' Gerar o .drawio: python3 scripts/drawio-seqgen/seqgen.py scripts/drawio-seqgen/exemplos/14-sequencia-uc001.puml especificacao/diagramas/14-sequencia-uc001.drawio
@startuml 14-sequencia-uc001
skinparam shadowing false
skinparam dpi 192
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam wrapMessageWidth 170
skinparam BoxPadding 8

actor "Aluno" as ALU
boundary TutorChatView as V
control TutorController as C
control TutorService as S
control TutorRateLimiter as T
control TutorCreditPackRepository as CP
control CourseTutorClient as CT
control MessageRepository as MR
database BD

ALU -> V ++ : envia pergunta (com videoTimestampSeconds opcional)
V -> C ++ : chat(req: AskTutorRequest)
C -> S ++ : ask( userId, lessonId, prompt, timestamp )
S -> T ++ : checkLimit(userId)
T --> S -- : cota ok? (20 msg/h janela deslizante)
alt E4 - Aluno sem matrícula no curso
  S --> C : 403 FORBIDDEN
  C --> V : 403 FORBIDDEN
  V --> ALU : informa matrícula obrigatória
else E1 - aula ainda não indexada
  S --> C : 409 LESSON_NOT_INDEXED
  C --> V : 409 LESSON_NOT_INDEXED
  V --> ALU : informa conteúdo em preparo
else cota horária excedida
  S -> CP ++ : findAvailablePack(userId)
  CP -> BD ++ : SELECT tutor_credit_packs WHERE credits_remaining > 0
  BD --> CP : pack (ou nulo)
  CP --> S : pack
  alt créditos extras disponíveis
    S -> CP ++ : decrementCredits(packId)
    CP -> BD ++ : UPDATE tutor_credit_packs SET credits_remaining = credits_remaining - 1
    BD --> CP : ok
    CP --> S : ok
  else E2 - sem cota e sem créditos extras
    S --> C : 429 TOO_MANY_REQUESTS (Retry-After)
    C --> V : 429 TOO_MANY_REQUESTS (Retry-After)
    V --> ALU : bloqueia envio, informa espera e oferta pacote extra
  end
end
opt pergunta liberada
  S -> CT ++ : streamRagResponse( courseId, lessonId, prompt, locale )
  alt E3 - falha no serviço de IA
    CT --> S : 503 SERVICE_UNAVAILABLE (Retry-After)
    S --> C : 503 SERVICE_UNAVAILABLE (Retry-After)
    C --> V : 503 SERVICE_UNAVAILABLE
    V --> ALU : informa erro e permite tentar novamente
  else resposta gerada com sucesso
    CT --> S : stream de resposta RAG com timestamps
    S -> MR ++ : create(MessageDTO): pergunta do Aluno
    MR -> BD ++ : INSERT INTO messages
    BD --> MR : ok
    MR --> S : message
    S -> MR ++ : create(MessageDTO): resposta do Tutor
    MR -> BD ++ : INSERT INTO messages
    BD --> MR : ok
    MR --> S : message
    S --> C : StreamedResponse (SSE)
    C --> V : 200 OK (SSE streaming)
    V --> ALU : exibe resposta no chat com citação do minuto
  end
end
@enduml
