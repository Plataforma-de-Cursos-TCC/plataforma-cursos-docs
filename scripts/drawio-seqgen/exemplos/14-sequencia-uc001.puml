' Item 14 - Diagrama de sequência do UC001 Conversar com Tutor de IA (Área D). Camadas e métodos do item 13.
' Gerar o .drawio: python3 scripts/drawio-seqgen/seqgen.py scripts/drawio-seqgen/exemplos/14-sequencia-uc001.puml especificacao/diagramas/14-sequencia-uc001.drawio
' findAvailablePack aparece duas vezes por serem fluxos distintos: no E2 confirma a ausência de pacote (429); no ramo liberado, com cota esgotada, obtém o pacote que será consumido.
@startuml 14-sequencia-uc001
skinparam shadowing false
skinparam dpi 192
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam wrapMessageWidth 170
skinparam BoxPadding 8

actor "Aluno" as ALU
boundary TutorChatView as V
control TutorController as C
control TutorService as S
control "EnrollmentService (Área C)" as ES
control "LessonService (Área B)" as LS
control TutorRateLimiter as T
control TutorCreditPackRepository as CP
control ConversationRepository as CV
control CourseTutorClient as CT
control MessageRepository as MR
database BD

ALU -> V ++ : envia pergunta (com videoTimestampSeconds opcional)
V -> C ++ : chat(req: AskTutorRequest)
C -> S ++ : ask(userId, lessonId, prompt, videoTimestampSeconds?)
S -> ES ++ : hasActiveEnrollment(userId, courseId)
ES --> S -- : hasEnrollment
alt E4 - Aluno sem matrícula no curso
  S --> C : 403 FORBIDDEN
  C --> V : 403 FORBIDDEN
  V --> ALU : informa matrícula obrigatória
else Aluno matriculado
  S -> LS ++ : isIndexed(lessonId)
  LS --> S -- : isIndexed
  alt E1 - aula ainda não indexada
    S --> C : 409 LESSON_NOT_INDEXED
    C --> V : 409 LESSON_NOT_INDEXED
    V --> ALU : informa conteúdo em preparo
  else E2 - cota horária esgotada e sem mensagens extras
    S -> T ++ : checkLimit(userId)
    T --> S -- : cota esgotada
    S -> T ++ : incrementAndGetWaitSeconds(userId)
    T --> S -- : waitSeconds (Retry-After)
    S -> CP ++ : findAvailablePack(userId)
    CP -> BD ++ : SELECT tutor_credit_packs WHERE messages_used < messages_total
    BD --> CP : nulo
    CP --> S : nulo
    S --> C : 429 TOO_MANY_REQUESTS (Retry-After)
    C --> V : 429 TOO_MANY_REQUESTS (Retry-After)
    V --> ALU : bloqueia envio, informa espera e oferta pacote extra
  else pergunta liberada (cota ok ou pacote extra com mensagem)
    opt cota horária esgotada, consome mensagem do pacote extra
      S -> CP ++ : findAvailablePack(userId)
      CP -> BD ++ : SELECT tutor_credit_packs WHERE messages_used < messages_total
      BD --> CP : pack
      CP --> S : pack
      S -> CP ++ : consumeMessage(packId)
      CP -> BD ++ : UPDATE tutor_credit_packs SET messages_used = messages_used + 1 WHERE messages_used < messages_total
      BD --> CP : ok
      CP --> S : ok
    end
    S -> CV ++ : findByUserAndLesson(userId, lessonId)
    CV -> BD ++ : SELECT conversations WHERE user_id AND lesson_id
    BD --> CV : conversa (ou nula)
    CV --> S : conversation
    opt conversa inexistente
      S -> CV ++ : create(userId, lessonId)
      CV -> BD ++ : INSERT INTO conversations (UNIQUE(user_id, lesson_id))
      BD --> CV : ok
      CV --> S : conversation
    end
    S -> CT ++ : streamRagResponse(courseId, lessonId, prompt, locale)
    alt E3 - falha no serviço de IA
      CT --> S : 503 SERVICE_UNAVAILABLE (Retry-After)
      S --> C : 503 SERVICE_UNAVAILABLE (Retry-After)
      C --> V : 503 SERVICE_UNAVAILABLE
      V --> ALU : informa erro e permite tentar novamente
    else resposta gerada com sucesso
      CT --> S : stream de resposta RAG com timestamps
      S -> MR ++ : create(conversationId, role=user, content, videoTimestampSeconds?)
      MR -> BD ++ : INSERT INTO messages
      BD --> MR : ok
      MR --> S : message
      S -> MR ++ : create(conversationId, role=assistant, content, videoTimestampSeconds?)
      MR -> BD ++ : INSERT INTO messages
      BD --> MR : ok
      MR --> S : message
      S --> C : StreamedResponse (SSE)
      C --> V : 200 OK (SSE streaming)
      V --> ALU : exibe resposta no chat com citação do minuto
    end
  end
end
@enduml
