' Item 14 - Diagrama de sequência do UC009 Assistir Aula. Mensagens e métodos do item 13.
' Gerar: python3 scripts/drawio-seqgen/seqgen.py <este arquivo> especificacao/diagramas/14-sequencia-uc009.drawio
@startuml 14-sequencia-uc009
actor Aluno
actor Visitante
boundary LessonPlayerView
control LessonPlayerController
control LessonProgressService
control MediaService
entity LessonProgress
control ProgressRepository
database BD
alt Visitante (sem login)
Visitante -> LessonPlayerView ++ : acessa a aula do curso
LessonPlayerView -> LessonPlayerController ++ : stream(lessonId)
LessonPlayerController -> LessonProgressService ++ : getStreamUrl(null, lessonId)
LessonProgressService -> LessonProgressService : checkEnrollmentOrPreview(null, lessonId)
alt E1 - aula privada (isPreview = false)
LessonProgressService --> LessonPlayerController : 401 UNAUTHENTICATED
LessonPlayerController --> LessonPlayerView : 401 UNAUTHENTICATED
LessonPlayerView --> Visitante : redireciona para tela de login
else A4 - aula prévia (isPreview = true)
LessonProgressService -> MediaService ++ : generateSignedStreamUrl(videoKey)
MediaService --> LessonProgressService -- : url assinada Cloudflare R2 (15 min)
LessonProgressService --> LessonPlayerController -- : LessonStreamDTO(streamUrl, null)
LessonPlayerController --> LessonPlayerView -- : 200 OK (LessonStreamResource)
LessonPlayerView --> Visitante -- : reproduz sem registrar progresso
end
else Aluno
Aluno -> LessonPlayerView ++ : acessa a aula do curso
LessonPlayerView -> LessonPlayerController ++ : stream(lessonId)
LessonPlayerController -> LessonProgressService ++ : getStreamUrl(userId, lessonId)
LessonProgressService -> LessonProgressService : checkEnrollmentOrPreview(userId, lessonId)
alt E1 - sem matrícula e aula não é prévia
LessonProgressService --> LessonPlayerController : 403 FORBIDDEN
LessonPlayerController --> LessonPlayerView : 403 FORBIDDEN
LessonPlayerView --> Aluno : bloqueia vídeo e sugere matrícula no curso (UC003)
else Aluno matriculado
LessonProgressService -> MediaService ++ : generateSignedStreamUrl(videoKey)
MediaService --> LessonProgressService -- : url assinada Cloudflare R2 (15 min)
alt E2 - falha ao carregar o vídeo
LessonProgressService --> LessonPlayerController : 503 SERVICE_UNAVAILABLE
LessonPlayerController --> LessonPlayerView : 503 SERVICE_UNAVAILABLE
LessonPlayerView --> Aluno : informa erro no vídeo e oferece tentar novamente
else vídeo disponível
LessonProgressService -> ProgressRepository ++ : findByEnrollmentAndLesson(enrollmentId, lessonId)
ProgressRepository -> BD ++ : SELECT lesson_progress WHERE enrollment_id AND lesson_id
BD --> ProgressRepository -- : progresso anterior
ProgressRepository --> LessonProgressService -- : progresso (ou null)
LessonProgressService --> LessonPlayerController -- : LessonStreamDTO(streamUrl, watchedSeconds)
LessonPlayerController --> LessonPlayerView -- : 200 OK (LessonStreamResource)
alt A2 - retoma aula já iniciada
LessonPlayerView --> Aluno : reproduz o vídeo a partir do ponto salvo
else início do vídeo
LessonPlayerView --> Aluno -- : reproduz a partir do início
end
alt A1 - Aluno sai antes do fim
Aluno -> LessonPlayerView ++ : pausa ou sai da tela
LessonPlayerView -> LessonPlayerController ++ : updateProgress(lessonId, req)
LessonPlayerController -> LessonProgressService ++ : recordProgress(userId, lessonId, dto)
LessonProgressService -> LessonProgress ++ : updateProgress(watchedSeconds, false)
LessonProgress --> LessonProgressService --
LessonProgressService -> ProgressRepository ++ : save(progress)
ProgressRepository -> BD ++ : UPDATE/INSERT lesson_progress
BD --> ProgressRepository --
ProgressRepository --> LessonProgressService --
LessonProgressService --> LessonPlayerController -- : ok
LessonPlayerController --> LessonPlayerView -- : 200 OK
LessonPlayerView --> Aluno -- : salva segundos assistidos e encerra
else vídeo assistido até o fim
Aluno -> LessonPlayerView ++ : assiste até o término do vídeo
LessonPlayerView -> LessonPlayerController ++ : updateProgress(lessonId, req)
LessonPlayerController -> LessonProgressService ++ : recordProgress(userId, lessonId, dto)
LessonProgressService -> LessonProgress ++ : markCompleted()
LessonProgress --> LessonProgressService --
LessonProgressService -> ProgressRepository ++ : save(progress)
ProgressRepository -> BD ++ : UPDATE lesson_progress SET completed = true, completed_at = NOW()
BD --> ProgressRepository --
ProgressRepository --> LessonProgressService --
LessonProgressService --> LessonPlayerController -- : ok
LessonPlayerController --> LessonPlayerView -- : 200 OK
LessonPlayerView --> Aluno -- : marca aula como concluída e atualiza progresso
end
end
end
end
@enduml
