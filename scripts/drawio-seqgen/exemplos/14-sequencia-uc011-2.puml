actor "Usuário" as USU
boundary RecuperarSenhaView as V
control AuthController as C
control ResetPasswordRequest as Q
control PasswordResetService as S
control UserRepository as R
control PasswordResetTokenRepository as TR
entity PasswordResetToken as PT
database BD

USU -> V ++ : abre o link, informa nova senha e confirmação
alt A2 - o Usuário cancela
  USU -> V : aciona "Cancelar"
  V --> USU -- : mantém a senha atual
else confirma
  USU -> V ++ : aciona "Redefinir"
  V -> C ++ : resetPassword(req: ResetPasswordRequest)
  C -> Q ++ : rules()
  Q --> C -- : erros de validação
  alt E4 - nova senha fora da política (R-3)
    C --> V : 422 VALIDATION_FAILED (fields.newPassword)
    V --> USU : informa a regra de senha
  else dados válidos
    C -> S ++ : reset(token, newPassword)
    S -> TR ++ : findValid(token)
    TR -> BD ++ : SELECT password_reset_token WHERE tokenHash
    BD --> TR -- : linha
    TR --> S -- : PasswordResetToken (ou nulo)
    opt o token existe
      S -> PT ++ : isUsed()
      PT --> S -- : usado?
      S -> PT ++ : isExpired()
      PT --> S -- : expirado?
    end
    alt E3 - link inexistente, adulterado ou já usado
      S --> C : InvalidTokenException
      C --> V : 422 RESET_TOKEN_INVALID
      V --> USU : informa que o link não é válido e oferece solicitar novo link
    else E2 - link expirado (30 min, RNF017)
      S --> C : ExpiredTokenException
      C --> V : 422 RESET_TOKEN_EXPIRED
      V --> USU : informa a expiração e oferece solicitar novo link
    else link válido
      S -> R ++ : save(user) com o hash da nova senha (RNF007)
      R -> BD ++ : UPDATE users SET passwordHash
      BD --> R --
      R --> S --
      S -> PT ++ : consume()
      PT --> S --
      S -> TR ++ : save(token)
      TR --> S --
      S --> C : ok
      C --> V : 200
      V --> USU : confirma e leva ao login (UC005)
    end
  end
end
