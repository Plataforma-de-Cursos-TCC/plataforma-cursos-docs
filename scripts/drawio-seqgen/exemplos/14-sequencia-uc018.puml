' Item 14 - Diagrama de sequência do UC018 Excluir e Anonimizar Usuário (Área D). Camadas e métodos do item 13.
' Gerar o .drawio: python3 scripts/drawio-seqgen/seqgen.py scripts/drawio-seqgen/exemplos/14-sequencia-uc018.puml especificacao/diagramas/14-sequencia-uc018.drawio
@startuml 14-sequencia-uc018
skinparam shadowing false
skinparam dpi 192
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam wrapMessageWidth 170
skinparam BoxPadding 8

actor "Administrador" as ADM
boundary UserAdminView as V
control UserController as C
control UserAdminService as S
control JwtGuard as J
control AuditService as A
control CourseService as CS
entity "RefreshSessionRepository (Área A)" as RSR
entity "UserRepository (Área A)" as R
database BD

ADM -> V ++ : aciona "Excluir" na linha do usuário
V --> ADM : exibe modal com aviso de exclusão lógica
alt A1 - Administrador cancela na confirmação (R-3)
  ADM -> V ++ : aciona "Cancelar"
  V --> ADM : fecha o modal sem alterar o usuário
else confirma a exclusão
  ADM -> V ++ : confirma exclusão
  V -> C ++ : destroy(id)
  C -> S ++ : softDelete(adminId, targetId)
  alt E1 - tentativa de excluir a própria conta (R-2)
    S --> C : 403 FORBIDDEN
    C --> V : 403 FORBIDDEN
    V --> ADM : erro: autoexclusão proibida
  else E2 - usuário não encontrado ou já excluído
    S --> C : 404 NOT_FOUND
    C --> V : 404 NOT_FOUND
    V --> ADM : informa usuário não encontrado e atualiza lista
  else exclusão lógica confirmada (ADR-0014)
    S -> R ++ : softDelete(targetId)
    R -> BD ++ : UPDATE users SET deleted_at = NOW()
    BD --> R : ok
    opt A4 - instrutor com cursos publicados
      alt arquivar cursos (alunos matriculados mantêm acesso)
        S -> CS ++ : archiveAllByInstructor(targetId)
        CS -> BD ++ : UPDATE courses SET status='archived' WHERE instructor_id=targetId
        BD --> CS : ok
        CS --> S : void
      else excluir cursos em cascata
        S -> CS ++ : softDeleteAllByInstructor(targetId)
        CS -> BD ++ : UPDATE courses, modules, lessons, quizzes SET deleted_at=NOW()
        BD --> CS : ok
        CS --> S : void
      end
    end
    S -> J ++ : revoke(jti, ttl)
    J --> S : ok (invalida jti no Redis blocklist)
    S -> RSR ++ : revokeAllByUser(targetId)
    RSR -> BD ++ : UPDATE refresh_sessions SET revoked_at=NOW() WHERE user_id=targetId
    BD --> RSR : ok
    RSR --> S : void
    S -> A ++ : logAction(adminId, USER_DELETE, "User", targetId)
    A -> BD ++ : INSERT INTO audit_logs (RNF016)
    BD --> A : ok
    A --> S : auditLog
    S --> C : void
    C --> V : 204 No Content
    V --> ADM : exibe confirmação e remove usuário da lista ativa
  end
else A2 - reativação de conta excluída (PATCH restore)
  ADM -> V ++ : aciona "Reativar" na conta excluída
  V -> C ++ : restore(id)
  C -> S ++ : restore(adminId, targetId)
  S -> R ++ : restore(targetId)
  R -> BD ++ : UPDATE users SET deleted_at = NULL
  BD --> R : ok
  R --> S : user
  S -> A ++ : logAction(adminId, USER_RESTORE, "User", targetId)
  A -> BD ++ : INSERT INTO audit_logs (RNF016)
  BD --> A : ok
  A --> S : auditLog
  S --> C : user
  C --> V : 200 OK (UserAdminResource)
  V --> ADM : conta reativada com status active
else A3 - anonimização irreversível (LGPD)
  ADM -> V ++ : aciona "Anonimizar" na conta excluída
  V -> C ++ : anonymize(id)
  C -> S ++ : anonymize(targetId)
  S -> R ++ : anonymize(targetId)
  R -> BD ++ : UPDATE users SET nome, e-mail, documento, anonymized_at=NOW() (user_id preservado)
  BD --> R : ok
  R --> S : ok
  S -> A ++ : logAction(adminId, USER_ANONYMIZE, "User", targetId)
  A -> BD ++ : INSERT INTO audit_logs (RNF016)
  BD --> A : ok
  A --> S : auditLog
  S --> C : void
  C --> V : 204 No Content
  V --> ADM : anonimização concluída e registrada
else E3 - reativar conta já anonimizada
  ADM -> V ++ : aciona "Reativar" em conta anonimizada
  V -> C ++ : restore(id)
  C -> S ++ : restore(adminId, targetId)
  S -> R ++ : findById(targetId)
  R --> S : user com anonymized_at preenchido
  S --> C : 422 VALIDATION_FAILED (fields.user)
  C --> V : 422 VALIDATION_FAILED
  V --> ADM : anonimização é irreversível pela LGPD
end
@enduml
