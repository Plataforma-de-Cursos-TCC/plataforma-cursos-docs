' Item 13 - Diagrama de classes, Área A (Acesso e conta). Notação do TE5_1 (ADR-0011).
' Perspectiva de Implementação (camadas MVC da API Laravel).
' Regra do TE5_1: a classe referencia o tipo (user: User), nunca o id da FK (userId).
' Gerar o PNG: plantuml -tpng 13-classes-area-a-implementacao.puml
@startuml 13-classes-area-a-implementacao
hide empty members
skinparam shadowing false
skinparam dpi 192
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor white
  BorderColor black
}

class User
class PasswordResetToken
class RefreshSession

  class AuthController <<Controller>> {
    +register(req: RegisterRequest): UserResource
    +login(req: LoginRequest): AuthResponse
    +forgotPassword(req: ForgotPasswordRequest): void
    +resetPassword(req: ResetPasswordRequest): void
  }
  class ProfileController <<Controller>> {
    +update(req: UpdateProfileRequest): UserResource
    +changePassword(req: ChangePasswordRequest): void
  }
  class RegisterRequest <<FormRequest>> {
    +rules(): array
  }
  class LoginRequest <<FormRequest>> {
    +rules(): array
  }
  class ForgotPasswordRequest <<FormRequest>> {
    +rules(): array
  }
  class ResetPasswordRequest <<FormRequest>> {
    +rules(): array
  }
  class UpdateProfileRequest <<FormRequest>> {
    +rules(): array
  }
  class ChangePasswordRequest <<FormRequest>> {
    +rules(): array
  }
  class AuthService <<Service>> {
    +register(dto: RegisterDTO): User
    +login(dto: LoginDTO): AuthTokens
  }
  class PasswordResetService <<Service>> {
    +requestReset(email: string): void
    +reset(token: string, novaSenha: string): void
  }
  class ProfileService <<Service>> {
    +update(user: User, dto: ProfileDTO): User
    +changePassword(user: User, current: string, novaSenha: string): void
  }
  class JwtGuard <<Service>> {
    +issue(user: User): string
    +issueRefresh(user: User): RefreshSession
  }
  class LoginThrottle <<Redis>> {
    +isBlocked(email: string): boolean
    +recordFailure(email: string): void
    +reset(email: string): void
  }
  class ResetMailer <<Service>> {
    +sendLink(user: User, token: string): void
  }
  class PhotoStorage <<R2>> {
    +store(file: UploadedFile): string
  }
  class UserRepository <<Repository>> {
    +findByEmail(email: string): User
    +save(user: User): User
  }
  class PasswordResetTokenRepository <<Repository>> {
    +issueFor(user: User): string
    +findValid(token: string): PasswordResetToken
    +save(token: PasswordResetToken): void
  }

AuthController ..> RegisterRequest
AuthController ..> LoginRequest
AuthController ..> ForgotPasswordRequest
AuthController ..> ResetPasswordRequest
ProfileController ..> UpdateProfileRequest
ProfileController ..> ChangePasswordRequest
AuthController --> AuthService
AuthController --> PasswordResetService
ProfileController --> ProfileService
AuthService --> UserRepository
AuthService --> JwtGuard
AuthService --> LoginThrottle
PasswordResetService --> UserRepository
PasswordResetService --> PasswordResetTokenRepository
PasswordResetService --> ResetMailer
ProfileService --> UserRepository
ProfileService --> PhotoStorage
UserRepository ..> User
PasswordResetTokenRepository ..> PasswordResetToken
JwtGuard ..> RefreshSession
@enduml
