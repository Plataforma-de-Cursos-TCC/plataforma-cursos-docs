        <mxCell id="note_integridade" value="&lt;b&gt;Regras de integridade e bloqueio de exclusão (Área C e ADR-0014):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;UC015 R-5:&lt;/b&gt; A exclusão de uma Lesson é bloqueada se houver registros em LessonProgress (progresso de alunos).&lt;br&gt;• &lt;b&gt;UC014 R-4:&lt;/b&gt; A exclusão de um Module é bloqueada se houver histórico de alunos (LessonProgress ou QuizAttempt).&lt;br&gt;• &lt;b&gt;UC006 R-2:&lt;/b&gt; A exclusão de um Course é bloqueada se houver matrículas ativas em Enrollment.&lt;br&gt;• &lt;b&gt;ADR-0014:&lt;/b&gt; Exclusão lógica com deleted_at em todas as tabelas de negócio; nenhum DELETE físico." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=6;spacingLeft=10;spacingRight=10;spacingBottom=6;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1130" width="450" height="150" as="geometry" />
        </mxCell>
        <mxCell id="note_quiz_rules" value="&lt;b&gt;Relação Módulo–Quiz e Gabarito (TDD seção 2):&lt;/b&gt;&lt;br&gt;• Cada Quiz pertence a exatamente um Module (1 Module para 0..n Quizzes).&lt;br&gt;• &lt;b&gt;UC004 R-1:&lt;/b&gt; Toda Question precisa de ao menos 2 alternativas (QuestionOption), com exatamente uma marcada como correta (isCorrect = true).&lt;br&gt;• &lt;b&gt;UC004 R-2:&lt;/b&gt; A edição do gabarito preserva tentativas e notas anteriores já registradas em QuizAttempt." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=6;spacingLeft=10;spacingRight=10;spacingBottom=6;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="1130" width="500" height="150" as="geometry" />
        </mxCell>
