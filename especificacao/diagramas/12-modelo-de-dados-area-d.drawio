        <mxCell id="note_audit" value="&lt;b&gt;AuditLog (RNF016):&lt;/b&gt;&lt;br&gt;Trilha retida por 12 meses via rotina diária (cron/scheduler); mecanismo a confirmar pelo grupo. Registra 100% das ações administrativas (UC008, UC016, UC018). Em exclusão (LGPD), nenhum dado pessoal vai no registro." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note_ai" value="&lt;b&gt;Tutor de IA (UC001):&lt;/b&gt;&lt;br&gt;Conversas e mensagens no core MySQL. Desvio justificado da 3FN em courseId para particionamento rápido no RAG (ai-service pgvector) sem joins multi-tabela." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note_analytics" value="&lt;b&gt;Analytics (UC007):&lt;/b&gt;&lt;br&gt;Métricas do Dashboard calculadas via agregação direta de matrículas e progresso de aulas; sem redundância de tabelas (sem tabela redundante de consolidação)." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
