' Item 14 - Diagrama de sequência do UC005 Realizar Login (ADR-0011). Camadas e métodos do item 13.
' Gerar o PNG: plantuml -tpng 14-sequencia-uc005.puml
@startuml 14-sequencia-uc005
skinparam shadowing false
skinparam dpi 192
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam wrapMessageWidth 170
skinparam ParticipantPadding 12
skinparam BoxPadding 8

actor "Usuário" as USU
boundary LoginView as V
control AuthController as C
control AuthService as S
control LoginThrottle as T
control UserRepository as R
entity User as U
control JwtGuard as J
database BD

USU -> V ++ : informa e-mail e senha e aciona "Entrar"
V -> C ++ : login(req: LoginRequest)
C -> S ++ : login(dto: LoginDTO)
S -> T ++ : isBlocked(email)
T --> S -- : bloqueado?

alt E4 - 5 tentativas inválidas (RNF008): bloqueado por 15 min
  S --> C : TooManyAttemptsException
  C --> V : 429
  V --> USU : informa o bloqueio temporário
else dentro do limite
  S -> R ++ : findByEmail(email)
  R -> BD ++ : SELECT users WHERE email
  BD --> R -- : linha
  R --> S -- : user
  alt E1 - e-mail inexistente ou senha incorreta
    S -> U ++ : checkPassword(senha)
    U --> S -- : false
    S -> T ++ : recordFailure(email)
    T --> S --
    S --> C : InvalidCredentialsException
    C --> V : 401
    V --> USU : mensagem genérica, sem revelar se o e-mail existe (R-1)
  else E3 - conta bloqueada pelo Administrador (status = blocked)
    S --> C : AccountBlockedException
    C --> V : 403
    V --> USU : informa que a conta está bloqueada
  else credenciais válidas
    S -> U ++ : checkPassword(senha)
    U --> S -- : true
    S -> T ++ : reset(email)
    T --> S --
    S -> J ++ : issue(user)
    J --> S -- : jwt (1 h)
    opt rememberMe verdadeiro
      S -> J ++ : issueRefresh(user)
      J -> BD ++ : INSERT refresh_session (tokenHash, familyId)
      BD --> J --
      J --> S -- : RefreshSession
    end
    S --> C : AuthTokens
    C --> V : 200 com cookies HttpOnly (UC016 direciona por perfil)
    V --> USU : exibe a área do perfil (Aluno, Instrutor ou Administrador)
  end
end
deactivate S
deactivate C
deactivate V

opt A1 - "Esqueci minha senha"
  USU -> V ++ : aciona "Esqueci minha senha"
  V --> USU -- : inicia o UC011 Recuperar Senha
end
@enduml
