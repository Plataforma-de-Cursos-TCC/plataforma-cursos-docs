ontColor=#000000;" parent="1" vertex="1"><mxGeometry x="1726" y="878" width="20" height="20" as="geometry" /></mxCell><mxCell id="cls_DashboardResource_methods" value="+toArray(request: Request): array" style="shape=partialRectangle;top=1;bottom=0;left=0;right=0;text;strokeColor=#000000;strokeWidth=1.5;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="1720" y="908" width="360" height="30" as="geometry" /></mxCell><mxCell id="frm_DashboardResource" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;" parent="1" vertex="1"><mxGeometry x="1720" y="868" width="360" height="70" as="geometry" /></mxCell><mxCell id="note_impl_tutor" value="&lt;b&gt;Regras de Implementação (Tutor de IA e Analytics):&lt;/b&gt;&lt;br&gt;• TutorController utiliza SSE (Server-Sent Events) para streaming de resposta em menos de 3s (RNF003).&lt;br&gt;• TutorService orquestra verificação de matrícula (E4), indexação da aula (E1) e cota de mensagens no Redis (E2, TutorRateLimiter).&lt;br&gt;• CourseTutorClient comunica-se com o microsserviço ai-service (PostgreSQL pgvector) respeitando o locale do usuário (RNF013).&lt;br&gt;• DashboardAnalyticsService agrega progresso e engajamento dinamicamente e impede que Instrutor consulte cursos alheios (UC007 R-2, 403 FORBIDDEN).&lt;br&gt;• Exceções (403 FORBIDDEN, 404 NOT_FOUND, 429 TOO_MANY_REQUESTS, 409 LESSON_NOT_INDEXED) são respostas de erro do TDD 3.1; não são classes." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="40" y="958" width="1640" height="130" as="geometry" /></mxCell><mxCell id="edge_0" value="" style="edgeStyle=orthogonalEdgeStyle;