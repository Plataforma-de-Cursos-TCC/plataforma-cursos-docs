eft=30;" parent="1" vertex="1"><mxGeometry x="1720" y="288" width="360" height="40" as="geometry" /></mxCell><mxCell id="icon_AuditLog" value="C" style="ellipse;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="1726" y="298" width="20" height="20" as="geometry" /></mxCell><mxCell id="cls_AuditLog_attrs" value="-id: UUID&lt;br&gt;-userId: UUID&lt;br&gt;-action: AuditAction&lt;br&gt;-targetType: string&lt;br&gt;-targetId: UUID&lt;br&gt;-ipAddress: string&lt;br&gt;-userAgent: string&lt;br&gt;-details: JSON&lt;br&gt;-createdAt: DateTime" style="shape=partialRectangle;top=1;bottom=0;left=0;right=0;text;strokeColor=#000000;strokeWidth=1.5;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="1720" y="328" width="360" height="158" as="geometry" /></mxCell><mxCell id="cls_AuditLog_methods" value="+isRecent(): boolean" style="shape=partialRectangle;top=1;bottom=0;left=0;right=0;text;strokeColor=#000000;strokeWidth=1.5;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="1720" y="486" width="360" height="30" as="geometry" /></mxCell><mxCell id="frm_AuditLog" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;" parent="1" vertex="1"><mxGeometry x="1720" y="288" width="360" height="228" as="geometry" /></mxCell><mxCell id="note_impl_admin" value="&lt;b&gt;Regras de Implementação da Área D:&lt;/b&gt;&lt;br&gt;• UserController e ProtectedAreaController delegam exclusivamente a Services.&lt;br&gt;• UserAdminService valida restrições R-1 e R-2 (auto-bloqueio E1 e auto-alteração de perfil E3 retornam 403 FORBIDDEN).&lt;br&gt;• Toda alteração de perfil (A4) e exclusão/anonimização (UC018) aciona AuditService.logAction (RNF016).&lt;br&gt;• EnsureUserHasRole valida o token com JwtGuard.parseToken, checa o perfil com JwtGuard.authorize e registra negações com AuditService.logAccessDenied (UC016 E2).&lt;br&gt;• Exceções (403 FORBIDDEN, 404 NOT_FOUND) são respostas de erro com o código do TDD 3.1; não são classes." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="40" y="668" width="1680" height="120" as="geometry" /></mxCell><mxCell id="edge_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;endArrow=open;endFill=0;endSize=8;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;" parent="1" edge="1" source="frm_UserController" target="frm_UserAdminService"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;endArrow=open;endFill=0;endSize=8;dashed=1;exitX=0;exitY=0.1;exitDx=0;exitDy=0;entryX=1;entryY=0.1;entryDx=0;entryDy=0;" parent="1" edge="1" source="frm_UserController" target="frm_ListUsersRequest"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;endArrow=open;endFill=0;endSize=8;dashed=1;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" parent="1" edge="1" source="frm_UserController" target="frm_UpdateUserStatusRequest"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_3" value="" style="edgeStyle=orth