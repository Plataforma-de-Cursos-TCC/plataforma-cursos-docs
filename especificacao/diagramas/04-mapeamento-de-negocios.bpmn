    <bpmn:startEvent id="v0" name="Quer fazer um curso">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="v1" name="Consulta o catálogo e escolhe um curso">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="v2" name="Cadastra-se ou faz login">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a2" name="Solicita a matrícula">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="p2" name="Curso é pago?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="p3" name="Processa o pagamento simulado">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="p4" name="Pagamento aprovado?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="p5" name="">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="p7" name="Informa a recusa do pagamento">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="pe" name="Matrícula não concluída">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="p6" name="Registra a matrícula">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a3" name="Assiste à aula">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="a4" name="Tem dúvida?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="a5" name="Pergunta ao Tutor de IA">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t1" name="Busca trechos do curso">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="t2" name="Há conteúdo relacionado?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3" name="Responde citando aula e timestamp">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Informa que o curso não cobre a dúvida">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="t5" name="">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="a6" name="Lê a resposta e retoma a aula">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="a7" name="">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="a8" name="Responde ao quiz do módulo">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p8" name="Calcula a nota e registra o progresso">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="p9" name="">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="a10" name="Deseja avaliar o curso?">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="p10" name="Agrega progresso e engajamento da turma">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a11" name="Avalia o curso">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="a12" name="Curso avaliado">
      <bpmn:incoming>Flow_30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="a13" name="Módulo concluído">
      <bpmn:incoming>Flow_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="p11" name="">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:startEvent id="i0" name="Novo curso">
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="i1" name="Cria curso, módulos e aulas com vídeo">
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p1" name="Armazena, transcreve e indexa as aulas">
      <bpmn:incoming>Flow_37</bpmn:incoming>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="i2" name="Cadastra quiz com gabarito">
      <bpmn:incoming>Flow_38</bpmn:incoming>
      <bpmn:outgoing>Flow_39</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="i3" name="Publica o curso">
      <bpmn:incoming>Flow_39</bpmn:incoming>
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="i4" name="Curso no catálogo">
      <bpmn:incoming>Flow_40</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="i8" name="Consulta o painel do curso">
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="i9" name="Turma acompanhada">
      <bpmn:incoming>Flow_34</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="d1" name="Consulta o dashboard da plataforma">
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="d2" name="Plataforma acompanhada">
      <bpmn:incoming>Flow_35</bpmn:incoming>
    </bpmn:endEvent>
