' Item 14 - Diagrama de sequência do UC017 Alterar Senha (ADR-0011). Camadas e métodos do item 13.
' Gerar o PNG: PLANTUML_LIMIT_SIZE=8192 plantuml -tpng 14-sequencia-uc017.puml
@startuml 14-sequencia-uc017
skinparam shadowing false
skinparam dpi 192
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam wrapMessageWidth 170
skinparam BoxPadding 8

actor "Usuário" as USU
boundary PerfilView as V
control ProfileController as C
control ChangePasswordRequest as Q
control ProfileService as S
entity User as U
control UserRepository as R
database BD

USU -> V ++ : informa senha atual, nova senha e confirmação e aciona "Salvar senha"
opt A1 - o Usuário cancela
  V --> USU : mantém a senha atual
end
V -> C ++ : changePassword(req: ChangePasswordRequest)
C -> Q ++ : rules()
Q --> C -- : erros de validação
alt E2 - nova senha fora da política (R-2)
  C --> V : 422 VALIDATION_FAILED (fields.newPassword)
  V --> USU : informa a regra de senha
else E3 - confirmação diferente da nova senha (R-3)
  C --> V : 422 VALIDATION_FAILED (fields.confirmation)
  V --> USU : informa que a confirmação não confere
else dados válidos
  C -> S ++ : changePassword(user, current, newPassword)
  S -> U ++ : checkPassword(current)
  U --> S -- : válida?
  alt E1 - senha atual incorreta (R-1)
    S --> C : WrongPasswordException
    C --> V : 422 VALIDATION_FAILED (fields.currentPassword)
    V --> USU : informa que a senha atual está incorreta
  else senha atual correta
    S -> U ++ : changePassword(current, newPassword)
    U --> S -- : hash da nova senha (RNF007)
    S -> R ++ : save(user)
    R -> BD ++ : UPDATE users SET passwordHash
    BD --> R --
    R --> S --
    S --> C : ok
    C --> V : 200
    V --> USU : confirma a alteração
  end
  deactivate S
end
deactivate C
deactivate V
@enduml
